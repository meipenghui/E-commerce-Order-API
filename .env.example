# Application
APP_NAME="E-commerce Order API"
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# JSON array; pydantic-settings parses complex values as JSON.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PostgreSQL / SQLAlchemy
# Local development URL. Docker Compose overrides the host with "postgres".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
# Order detail cache lifetime in seconds.
ORDER_CACHE_TTL=600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Cancel unpaid orders after this many seconds.
ORDER_TIMEOUT_SECONDS=1800

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Compose / PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Host ports
API_PORT=8000
REDIS_PORT=6379
